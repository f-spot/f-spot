# EditorConfig is awesome: http://EditorConfig.org
root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# SDK / NuGet XML is space-2 across the .NET ecosystem.
[*.{csproj,proj,projitems,shproj,fsproj,targets,props}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.{cs,vb}]
# Default is false:silent. Suggestion so `this.` / `Me.` gets cleaned up.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Default is for_non_interface_members.
dotnet_style_require_accessibility_modifiers = omit_if_default:suggestion

[*.cs]
# Default is Method(. The tree uses Mono spacing: Method (.
csharp_space_between_method_declaration_name_and_open_parenthesis = true
csharp_space_between_method_call_name_and_opening_parenthesis = true

# Default is all (Allman). Types and methods stay Allman; if/else stay K&R.
csharp_new_line_before_open_brace = types,methods
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false

# Default is true (indent case). Match the existing switch style.
csharp_indent_switch_labels = false

# Default is false. Prefer var when the type is on the right-hand side.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion

# Default is true (always braces). Single-statement if is fine.
csharp_prefer_braces = when_multiline:silent

# CA1303: Do not pass literals as localized parameters
dotnet_diagnostic.CA1303.severity = none

# CA2007: Consider calling ConfigureAwait on the awaited task.
# On by default only at higher analysis levels. Turned on while F-Spot's own code has no
# async at all, so the convention is set before the code exists rather than retrofitted
# across hundreds of awaits later. (external/ does contain awaits, but external/
# Directory.Build.props blocks inheritance, so no CA rule reaches the submodules.)
#
# Library code only, which is what the rule is for and what makes promoting it to an
# error in Directory.Build.props safe. It does not demand ConfigureAwait(false) --
# ConfigureAwait(true) satisfies it too -- but in the GTK client and the extensions
# essentially every await wants to resume on the UI thread, so requiring the annotation
# there is noise that would block the first await written. src/Core and lib/ can be
# called from a worker, so there the choice is worth stating.
dotnet_diagnostic.CA2007.severity = warning

# The GTK client and the extensions are UI-affine: their continuations belong on the
# main loop, which is the default a bare await already gives them.
[src/{Clients,Extensions}/**.cs]
dotnet_diagnostic.CA2007.severity = none

# ConfigureAwait(false) in a test is conventionally noise: the test host has no
# synchronization context to deadlock against, and MSTest resumes the continuation itself.
[tests/**.cs]
dotnet_diagnostic.CA2007.severity = none
