<Project>
  <Import Project="fspot.props" />

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <OutputPath>$(RepoRoot)\bin</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <FSpotModernTargetFramework>net10.0</FSpotModernTargetFramework>
    <NetStandard>netstandard2.0</NetStandard>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Pinned so a later SDK does not silently move the CA rule set. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <!-- Both report zero occurrences today, which is what makes promoting them free.
         VSTHRD100 is an error because an async void handler turns an unhandled
         exception into a process abort, and CI builds without -warnaserror. -->
    <WarningsAsErrors>VSTHRD100;CA2007</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Lots of warning this'll be a long slow process -->
    <!-- <Nullable>enable</Nullable> -->
    <NoWarn>NU1507</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!-- Assembly Info -->
  <PropertyGroup>
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <Title>F-Spot</Title>
    <Description>Personal photo management</Description>
    <Copyright>Copyright (C) 2003-2012 Novell Inc. and others</Copyright>
  </PropertyGroup>

  <!-- The SDK supplies the CA rules via EnableNETAnalyzers above, so
       Microsoft.CodeAnalysis.NetAnalyzers is not referenced; it only warned that the
       SDK's copy was newer. The threading analyzers stay: measured against a probe of
       five async hazards, the SDK caught none and these caught four, including
       VSTHRD100 (async void), which crashes the process.
       Microsoft.VisualStudio.Threading itself is gone, since no API of it was used. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
