<Project>
    <Import Project="$(MSBuildThisFileDirectory)GtkSharp.refs.targets" />

    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.12 net461 targets copy win-arm e_sqlite3.dll,
         which is not in the package (win-x86/x64/arm64 only). AnyCPU net472 then fails MSB3030. -->
    <Target Name="RemoveMissingSqliteNativeContent" BeforeTargets="AssignTargetPaths">
        <ItemGroup>
            <Content Remove="@(Content)" Condition="'%(Filename)' == 'e_sqlite3' AND !Exists('%(Identity)')" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Remove="*.txt" />
        <None Remove="*.sh" />
        <None Remove="*.raw" />
        <None Remove="*.custom" />
        <None Remove="*.metadata" />
    </ItemGroup>

</Project>

