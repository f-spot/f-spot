<Project>
    <Import Project="$(MSBuildThisFileDirectory)Icons.targets" />

    <!-- SQLitePCLRaw.lib.e_sqlite3 lists a win-arm e_sqlite3.dll the package does not ship. -->
    <Target Name="RemoveMissingSqliteNativeContent" BeforeTargets="AssignTargetPaths">
        <ItemGroup>
            <Content Remove="@(Content)" Condition="'%(Filename)' == 'e_sqlite3' AND !Exists('%(Identity)')" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Remove="*.txt" />
        <None Remove="*.sh" />
        <None Remove="*.raw" />
        <None Remove="*.custom" />
        <None Remove="*.metadata" />
    </ItemGroup>

</Project>

