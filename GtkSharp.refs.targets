<Project>
  <!-- Compile-only gtk-sharp 2.12 refs; dotnet MSBuild does not use the Mono GAC. -->
  <PropertyGroup>
    <GtkSharpLibDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)lib\gtk-sharp-2.12'))</GtkSharpLibDir>
  </PropertyGroup>

  <Target Name="AddGtkSharpHintPaths" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Condition="$([System.String]::Copy('%(Identity)').StartsWith('atk-sharp'))">
        <HintPath>$(GtkSharpLibDir)atk-sharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Condition="$([System.String]::Copy('%(Identity)').StartsWith('gdk-sharp'))">
        <HintPath>$(GtkSharpLibDir)gdk-sharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Condition="$([System.String]::Copy('%(Identity)').StartsWith('glib-sharp'))">
        <HintPath>$(GtkSharpLibDir)glib-sharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Condition="$([System.String]::Copy('%(Identity)').StartsWith('gtk-sharp'))">
        <HintPath>$(GtkSharpLibDir)gtk-sharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Condition="$([System.String]::Copy('%(Identity)').StartsWith('pango-sharp'))">
        <HintPath>$(GtkSharpLibDir)pango-sharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Condition="$([System.String]::Copy('%(Identity)').StartsWith('gtk-dotnet'))">
        <HintPath>$(GtkSharpLibDir)gtk-dotnet.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Condition="'%(Identity)' == 'Mono.Cairo'">
        <HintPath>$(GtkSharpLibDir)Mono.Cairo.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Condition="'%(Identity)' == 'Mono.Posix'">
        <HintPath>$(GtkSharpLibDir)Mono.Posix.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
