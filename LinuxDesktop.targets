<Project>
  <!-- Linux/Freedesktop prefix layout. macOS app bundle and Windows installer are separate.
       Invoke: dotnet msbuild LinuxDesktop.targets -t:InstallLinux -p:Prefix=/usr/local
       FSpot.Gtk imports this so a normal build stages icons next to the exe.
       Do not set DefaultTargets: an imported DefaultTargets becomes Gtk's, and
       ProjectReference then runs icon copy instead of compiling f-spot.exe. -->

  <PropertyGroup>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)</RepoRoot>
    <FSpotOutputDir Condition="'$(FSpotOutputDir)' == ''">$([MSBuild]::NormalizeDirectory($([System.IO.Path]::Combine('$(RepoRoot)', 'bin'))))</FSpotOutputDir>
    <FSpotAppShare>$([MSBuild]::NormalizeDirectory($([System.IO.Path]::Combine('$(FSpotOutputDir)', 'share', 'f-spot'))))</FSpotAppShare>
    <Prefix Condition="'$(Prefix)' == ''">$([System.IO.Path]::Combine('$(RepoRoot)', 'artifacts', 'linux-desktop'))</Prefix>
    <FSpotBindir>$([MSBuild]::NormalizeDirectory($([System.IO.Path]::Combine('$(Prefix)', 'bin'))))</FSpotBindir>
    <FSpotLibdir>$([MSBuild]::NormalizeDirectory($([System.IO.Path]::Combine('$(Prefix)', 'lib', 'f-spot'))))</FSpotLibdir>
    <FSpotApplicationsDir>$([MSBuild]::NormalizeDirectory($([System.IO.Path]::Combine('$(Prefix)', 'share', 'applications'))))</FSpotApplicationsDir>
    <FSpotHelpDir>$([MSBuild]::NormalizeDirectory($([System.IO.Path]::Combine('$(Prefix)', 'share', 'help', 'C', 'f-spot'))))</FSpotHelpDir>
    <FSpotInstalledHicolor>$([MSBuild]::NormalizeDirectory($([System.IO.Path]::Combine('$(FSpotLibdir)', 'share', 'f-spot', 'icons', 'hicolor'))))</FSpotInstalledHicolor>
  </PropertyGroup>

  <ItemGroup>
    <HicolorIcon Include="$(RepoRoot)icons\f-spot-16.png;$(RepoRoot)icons\f-spot-22.png;$(RepoRoot)icons\f-spot-24.png;$(RepoRoot)icons\f-spot-32.png;$(RepoRoot)icons\f-spot-48.png;$(RepoRoot)icons\f-spot-128.png;$(RepoRoot)icons\f-spot-256.png">
      <Category>apps</Category>
    </HicolorIcon>
    <HicolorIcon Include="$(RepoRoot)icons\adjust-colors-*.png;$(RepoRoot)icons\align-horizon-*.png;$(RepoRoot)icons\autocolor-*.png;$(RepoRoot)icons\color-desaturate-*.png;$(RepoRoot)icons\color-sepia-*.png;$(RepoRoot)icons\crop-*.png;$(RepoRoot)icons\filter-soft-focus-*.png;$(RepoRoot)icons\object-rotate-*.png;$(RepoRoot)icons\rating-*.png;$(RepoRoot)icons\red-eye-remove-*.png;$(RepoRoot)icons\tag-*.png;$(RepoRoot)icons\view-*.png">
      <Category>actions</Category>
    </HicolorIcon>
    <HicolorIcon Include="$(RepoRoot)icons\camera-photo-*.png">
      <Category>devices</Category>
    </HicolorIcon>
    <HicolorIcon Include="$(RepoRoot)icons\emblem-*.png">
      <Category>emblems</Category>
    </HicolorIcon>
    <HicolorIcon Include="$(RepoRoot)icons\film-roll-*.png">
      <Category>places</Category>
    </HicolorIcon>
    <HicolorIcon Include="$(RepoRoot)icons\mode-browse-*.png;$(RepoRoot)icons\mode-image-edit-*.png;$(RepoRoot)icons\f-spot-question-mark.png">
      <Category>status</Category>
    </HicolorIcon>
    <DesktopFile Include="$(RepoRoot)data\desktop-files\*.desktop" />
    <BindirTool Include="$(RepoRoot)tools\f-spot;$(RepoRoot)tools\f-spot-import;$(RepoRoot)tools\f-spot-sqlite-upgrade" />
    <HelpPage Include="$(RepoRoot)help\C\*.page" />
    <HelpFigure Include="$(RepoRoot)help\C\figures\*.png" />
  </ItemGroup>

  <Target Name="LayoutLinuxShare">
    <ItemGroup>
      <_HicolorStaged Include="@(HicolorIcon)">
        <_SizeDigits>$([System.Text.RegularExpressions.Regex]::Match('%(Filename)', '-([0-9]+)$').Groups[1].Value)</_SizeDigits>
      </_HicolorStaged>
      <_HicolorStaged>
        <_ThemeSize Condition="'%(_SizeDigits)' != ''">%(_SizeDigits)x%(_SizeDigits)</_ThemeSize>
        <_ThemeSize Condition="'%(_SizeDigits)' == ''">scalable</_ThemeSize>
        <_ThemeName>$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)', '-?[0-9]+', ''))</_ThemeName>
      </_HicolorStaged>
      <_HicolorStaged>
        <Destination>$(FSpotAppShare)icons\hicolor\%(_ThemeSize)\%(Category)\%(_ThemeName)%(Extension)</Destination>
      </_HicolorStaged>
    </ItemGroup>
    <Copy SourceFiles="@(_HicolorStaged)" DestinationFiles="@(_HicolorStaged->'%(Destination)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="InstallLinux" DependsOnTargets="LayoutLinuxShare">
    <MakeDir Directories="$(FSpotBindir);$(FSpotLibdir);$(FSpotApplicationsDir);$(FSpotHelpDir)figures" />
    <ItemGroup>
      <_Built Include="$(FSpotOutputDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_Built)" DestinationFiles="@(_Built->'$(FSpotLibdir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DesktopFile)" DestinationFolder="$(FSpotApplicationsDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BindirTool)" DestinationFolder="$(FSpotBindir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HelpPage)" DestinationFolder="$(FSpotHelpDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HelpFigure)" DestinationFolder="$(FSpotHelpDir)figures" SkipUnchangedFiles="true" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="chmod +x &quot;$(FSpotBindir)f-spot&quot; &quot;$(FSpotBindir)f-spot-import&quot; &quot;$(FSpotBindir)f-spot-sqlite-upgrade&quot;" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="command -v update-desktop-database >/dev/null &amp;&amp; update-desktop-database &quot;$(FSpotApplicationsDir)&quot; || true" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="command -v gtk-update-icon-cache >/dev/null &amp;&amp; gtk-update-icon-cache -f -t &quot;$(FSpotInstalledHicolor)&quot; || true" />
  </Target>
</Project>
