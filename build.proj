<Project DefaultTargets="Build">
  <Import Project="fspot.props" />

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <PortableSolution>$(MSBuildThisFileDirectory)F-Spot.Portable.slnf</PortableSolution>
    <FullSolution>$(MSBuildThisFileDirectory)F-Spot.slnx</FullSolution>
    <TestSolution>$(MSBuildThisFileDirectory)F-Spot.Tests.slnf</TestSolution>
  </PropertyGroup>

  <Target Name="Clean">
    <Exec Command="dotnet clean &quot;$(FullSolution)&quot; --configuration $(Configuration)" />
  </Target>

  <Target Name="Restore">
    <Exec Command="dotnet restore &quot;$(FullSolution)&quot;" />
  </Target>

  <Target Name="Build" DependsOnTargets="Restore">
    <Exec Command="dotnet build &quot;$(FullSolution)&quot; --configuration $(Configuration) --no-restore" />
  </Target>

  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />

  <!-- FSpot.Strings, FSpot.Resources, FSpot (gtk-free). -->
  <Target Name="Portable">
    <Exec Command="dotnet restore &quot;$(PortableSolution)&quot;" />
    <Exec Command="dotnet build &quot;$(PortableSolution)&quot; --configuration $(Configuration) --no-restore" />
  </Target>

  <Target Name="Test" DependsOnTargets="Build">
    <Exec Command="dotnet test &quot;$(TestSolution)&quot; --configuration $(Configuration) --no-build --filter &quot;TestCategory!=RequiresGdk&amp;TestCategory!=RequiresGtk&quot; --logger trx --results-directory TestResults" />
  </Target>

  <Target Name="InstallLinux" DependsOnTargets="Build">
    <!-- A blank Prefix forwarded as a global property cannot be overridden by
         LinuxDesktop.targets' artifacts/linux-desktop default. -->
    <MSBuild Condition="'$(Prefix)' != ''" Projects="$(MSBuildThisFileDirectory)LinuxDesktop.targets" Targets="InstallLinux" Properties="Prefix=$(Prefix)" />
    <MSBuild Condition="'$(Prefix)' == ''" Projects="$(MSBuildThisFileDirectory)LinuxDesktop.targets" Targets="InstallLinux" />
  </Target>
</Project>

