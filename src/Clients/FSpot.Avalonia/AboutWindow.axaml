<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FSpot.Avalonia.ViewModels"
        xmlns:auto="using:FSpot.Avalonia"
        xmlns:lang="using:FSpot.Resources.Lang"
        x:Class="FSpot.Avalonia.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="{x:Static lang:Strings.AboutFSpot}"
        Width="420"
        Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AboutWindow}"
        AutomationProperties.Name="{x:Static lang:Strings.AboutFSpot}">
	<StackPanel Margin="24" Spacing="8">
		<Image Width="64" Height="64" HorizontalAlignment="Left"
		       Source="avares://FSpot.Avalonia/Icons/f-spot-256.png"
		       AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AboutLogo}"
		       AutomationProperties.Name="{x:Static lang:Strings.FSpot}" />
		<TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Static lang:Strings.FSpot}" />
		<TextBlock Text="{Binding Version}"
		           AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AboutVersion}" />
		<TextBlock TextWrapping="Wrap" Text="{Binding Description}"
		           AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AboutDescription}" />
		<TextBlock Text="{x:Static lang:Strings.FSpotHomeUrl}" />
		<Button HorizontalAlignment="Right"
		        Margin="0,16,0,0"
		        Content="{x:Static lang:Strings.Close}"
		        Click="OnClose"
		        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AboutClose}"
		        AutomationProperties.Name="{x:Static lang:Strings.Close}" />
	</StackPanel>
</Window>
