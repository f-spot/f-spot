<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:lang="using:FSpot.Resources.Lang"
             xmlns:utils="using:FSpot.Utils"
             xmlns:vm="using:FSpot.Avalonia.ViewModels"
             x:Class="FSpot.Avalonia.App"
             Name="{x:Static lang:Strings.FSpot}"
             RequestedThemeVariant="Default">
	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="{x:Static lang:Strings.AboutFSpot}" Click="OnAboutClicked" />
		</NativeMenu>
	</NativeMenu.Menu>
	<Application.Styles>
		<FluentTheme />
		<Style Selector="Button /template/ ContentPresenter, CheckBox /template/ ContentPresenter, Label /template/ ContentPresenter">
			<Setter Property="RecognizesAccessKey" Value="True" />
		</Style>
		<Style Selector="Button">
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button /template/ AccessText">
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="GridSplitter.hairline">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Width" Value="5" />
			<Setter Property="MinWidth" Value="5" />
			<Setter Property="Template">
				<ControlTemplate>
					<Panel Background="Transparent">
						<Border Width="1" HorizontalAlignment="Center"
						        Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
					</Panel>
				</ControlTemplate>
			</Setter>
		</Style>
		<!-- Fluent's horizontal slider is 15 + 32 + 15. The status bar is 24px,
		     so the zoom control is a 16px line centered in that row. -->
		<Style Selector="Slider.zoom">
			<Style.Resources>
				<GridLength x:Key="SliderPreContentMargin">0</GridLength>
				<GridLength x:Key="SliderPostContentMargin">0</GridLength>
				<sys:Double x:Key="SliderHorizontalHeight">16</sys:Double>
				<sys:Double x:Key="SliderHorizontalThumbWidth">12</sys:Double>
				<sys:Double x:Key="SliderHorizontalThumbHeight">12</sys:Double>
			</Style.Resources>
		</Style>
		<Style Selector="Button.tool, ToggleButton.tool, RadioButton.tool">
			<Setter Property="MinWidth" Value="32" />
			<Setter Property="MinHeight" Value="32" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<!-- Fluent paints the face on the presenter. Setting Background on the
		     button leaves the dark chip in place. -->
		<Style Selector="Button.tool /template/ ContentPresenter, ToggleButton.tool /template/ ContentPresenter, RadioButton.tool /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter, RadioButton.tool:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
		</Style>
		<Style Selector="Button.tool:pressed /template/ ContentPresenter, ToggleButton.tool:pressed /template/ ContentPresenter, RadioButton.tool:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
		</Style>
		<Style Selector="Button.tool:disabled /template/ ContentPresenter, ToggleButton.tool:disabled /template/ ContentPresenter, RadioButton.tool:disabled /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="RadioButton.tool:checked, ToggleButton.tool:checked">
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="RadioButton.tool:checked /template/ ContentPresenter, ToggleButton.tool:checked /template/ ContentPresenter, RadioButton.tool:checked:pointerover /template/ ContentPresenter, ToggleButton.tool:checked:pointerover /template/ ContentPresenter, RadioButton.tool:checked:pressed /template/ ContentPresenter, ToggleButton.tool:checked:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="Path.glyph">
			<Setter Property="Width" Value="16" />
			<Setter Property="Height" Value="16" />
			<Setter Property="Margin" Value="0,-1,0,1" />
			<Setter Property="Stretch" Value="None" />
			<Setter Property="Fill" Value="Transparent" />
			<Setter Property="StrokeThickness" Value="1.5" />
			<Setter Property="StrokeLineCap" Value="Round" />
			<Setter Property="StrokeJoin" Value="Round" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.sidebar-chooser">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Padding" Value="6,4" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Button.sidebar-close">
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Button.editor">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="Margin" Value="0,0,0,5" />
		</Style>
		<Style Selector="ListBoxItem:focus">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="BorderThickness" Value="2" />
		</Style>
		<!-- The photo grid's own 1px outline is the selection. This focus ring would
		     stack a second, heavier box on the thumbnail. -->
		<Style Selector="ListBox.photo-grid ListBoxItem:focus, ListBox.photo-grid ListBoxItem:focus-within, ListBox.photo-grid ListBoxItem:selected">
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="BorderBrush" Value="Transparent" />
		</Style>
		<!-- The filmstrip reserves FilmstripFrame on every cell. This keeps the app focus
		     border from growing only the selected thumbnail after the row has been measured. -->
		<Style Selector="ListBox.filmstrip ListBoxItem">
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="BorderThickness" Value="{x:Static vm:MainWindowViewModel.FilmstripFrame}" />
			<Setter Property="FocusAdorner" Value="{x:Null}" />
		</Style>
		<Style Selector="ListBox.filmstrip ListBoxItem:focus, ListBox.filmstrip ListBoxItem:focus-within, ListBox.filmstrip ListBoxItem:selected">
			<Setter Property="BorderThickness" Value="{x:Static vm:MainWindowViewModel.FilmstripFrame}" />
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
		</Style>
		<Style Selector=".timeline-month:focus Border">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="Button.timeline-scroll">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="TreeView.sidebar">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
		</Style>
		<Style Selector="TreeView.sidebar TreeViewItem">
			<Setter Property="Padding" Value="0,1" />
			<Setter Property="MinHeight" Value="22" />
		</Style>
		<Style Selector="TextBlock.info-label">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="TextAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="Margin" Value="0,3,6,3" />
			<Setter Property="Opacity" Value="0.85" />
		</Style>
		<Style Selector="TextBlock.info-value">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="TextWrapping" Value="NoWrap" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="Margin" Value="0,3,0,3" />
		</Style>
		<Style Selector="TextBlock.info-date">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextTrimming" Value="None" />
		</Style>
		<Style Selector="TextBlock.folder-count">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="{x:Static utils:TimelineChrome.FolderCountOpacity}" />
			<Setter Property="Margin" Value="8,0,4,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.query-bar">
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
		</Style>
		<Style Selector="Border.query-chip">
			<Setter Property="Padding" Value="6,2,2,2" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
		</Style>
		<Style Selector="Button.chip-close">
			<Setter Property="Padding" Value="4,0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Expander.sidebar">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="2,0" />
			<Setter Property="Padding" Value="2" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		</Style>
	</Application.Styles>
</Application>
