<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:FSpot.Avalonia.Controls"
             xmlns:lang="using:FSpot.Resources.Lang"
             x:Class="FSpot.Avalonia.Controls.TimelineStrip"
             x:Name="Root"
             Classes="timeline-month"
             Focusable="True"
             Height="48">
	<Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
	        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
	        BorderThickness="0,0,0,1"
	        AutomationProperties.Name="{x:Static lang:Strings.Timeline}">
		<!-- Arrow columns and the handle row match TimelineLayout.ArrowWidth and HandleHeight. -->
		<Grid ColumnDefinitions="16,*,16" RowDefinitions="*,14">
			<RepeatButton x:Name="ScrollLeft" Classes="timeline-scroll" Padding="0"
			              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			              Delay="160" Interval="40" Click="OnScrollLeft"
			              AutomationProperties.Name="{x:Static lang:Strings.Previous}"
			              ToolTip.Tip="{x:Static lang:Strings.Previous}">
				<Path Width="8" Height="10" Stretch="Uniform" StrokeThickness="1.6"
				      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
				      Data="M 7,1 L 1,5 L 7,9" />
			</RepeatButton>
			<ScrollViewer x:Name="Scroller" Grid.Column="1" Grid.RowSpan="2"
			              HorizontalScrollBarVisibility="Hidden"
			              VerticalScrollBarVisibility="Disabled">
				<controls:TimelineScale x:Name="Scale" VerticalAlignment="Stretch"
				                        Items="{Binding #Root.Items}"
				                        SelectCommand="{Binding #Root.SelectCommand}"
				                        RangeCommand="{Binding #Root.RangeCommand}"
				                        LimitsCommand="{Binding #Root.LimitsCommand}" />
			</ScrollViewer>
			<RepeatButton x:Name="ScrollRight" Grid.Column="2" Classes="timeline-scroll" Padding="0"
			              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			              Delay="160" Interval="40" Click="OnScrollRight"
			              AutomationProperties.Name="{x:Static lang:Strings.Next}"
			              ToolTip.Tip="{x:Static lang:Strings.Next}">
				<Path Width="8" Height="10" Stretch="Uniform" StrokeThickness="1.6"
				      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
				      Data="M 1,1 L 7,5 L 1,9" />
			</RepeatButton>
		</Grid>
	</Border>
</UserControl>
