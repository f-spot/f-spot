<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:FSpot.Avalonia"
        xmlns:lang="using:FSpot.Resources.Lang"
        xmlns:core="using:FSpot"
        x:Class="FSpot.Avalonia.ExtensionsWindow"
        Title="{x:Static lang:Strings.ExtensionManager}"
        Width="700"
        Height="550"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ExtensionsWindow}"
        AutomationProperties.Name="{x:Static lang:Strings.ExtensionManager}">
	<DockPanel Margin="12">
		<Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0"
		        Content="{x:Static lang:Strings.Close}" Click="OnClose" />
		<TabControl>
			<TabItem Header="{x:Static lang:Strings.Installed}">
				<DockPanel Margin="8">
					<TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
					           Text="{x:Static lang:Strings.TheFollowingExtensionsAreCurrentlyInstalled}" />
					<ListBox Name="Addins"
					         AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ExtensionsList}"
					         AutomationProperties.Name="{x:Static lang:Strings.Installed}">
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel />
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="core:AddinStatus">
								<CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}"
								          AutomationProperties.AutomationId="{Binding Id, StringFormat=Extensions.{0}}"
								          AutomationProperties.Name="{Binding Name}" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</TabItem>
			<TabItem Header="{x:Static lang:Strings.Updates}">
				<StackPanel Margin="8" Orientation="Horizontal" Spacing="8">
					<TextBlock VerticalAlignment="Center" Text="{x:Static lang:Strings.NoUpdatesFound}" />
					<Button Content="{x:Static lang:Strings.Refresh}" IsEnabled="False" />
					<Button Name="UpdateAll" Content="{x:Static lang:Strings.UpdateAll}" IsEnabled="False" />
				</StackPanel>
			</TabItem>
			<TabItem Header="{x:Static lang:Strings.Gallery}">
				<DockPanel Margin="8">
					<Button Name="InstallFromFile" DockPanel.Dock="Bottom" HorizontalAlignment="Left"
					        Content="{x:Static lang:Strings.InstallFromFile}" IsEnabled="False" />
					<TextBlock Text="{x:Static lang:Strings.Repository}" />
				</DockPanel>
			</TabItem>
		</TabControl>
	</DockPanel>
</Window>
