<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(FSpotModernTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>FSpot.Avalonia</RootNamespace>
    <AssemblyName>FSpot.Avalonia</AssemblyName>
    <ApplicationTitle>F-Spot</ApplicationTitle>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RasterizeIcons>true</RasterizeIcons>
    <OutputPath>$(RepoRoot)artifacts/fspot-avalonia/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FSpot.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\FSpot\FSpot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Sentry.Serilog" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="$(RepoRoot)icons/src/*.svg">
      <Link>Icons\%(Filename)%(Extension)</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="$(RepoRoot)icons/f-spot-32.png">
      <Link>Icons\f-spot-32.png</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="$(RepoRoot)icons/f-spot-256.png">
      <Link>Icons\f-spot-256.png</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="$(RepoRoot)icons/crop-22.png">
      <Link>Icons\crop-22.png</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="$(RepoRoot)icons/red-eye-remove-22.png">
      <Link>Icons\red-eye-remove-22.png</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="$(RepoRoot)icons/filter-soft-focus-22.png">
      <Link>Icons\filter-soft-focus-22.png</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="$(RepoRoot)icons/emblem-favorite-22.png">
      <Link>Icons\emblem-favorite-22.png</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="$(RepoRoot)icons/emblem-readonly-22.png">
      <Link>Icons\emblem-readonly-22.png</Link>
    </AvaloniaResource>
  </ItemGroup>

</Project>
