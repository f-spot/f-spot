<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FSpot.Avalonia.ViewModels"
        xmlns:svg="using:Avalonia.Svg.Skia"
        xmlns:auto="using:FSpot.Avalonia"
        xmlns:lang="using:FSpot.Resources.Lang"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="FSpot.Avalonia.ImportWindow"
        x:DataType="vm:ImportViewModel"
        Title="{x:Static lang:Strings.Import}"
        Width="780"
        Height="560"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportWindow}"
        AutomationProperties.Name="{x:Static lang:Strings.Import}">
	<DockPanel Margin="12">
		<Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
			<Button HorizontalAlignment="Right"
			        Margin="0,0,8,0"
			        Grid.Column="1"
			        Content="{x:Static lang:Strings.Cancel}"
			        Command="{Binding CancelCommand}"
			        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportCancel}"
			        AutomationProperties.Name="{x:Static lang:Strings.Cancel}" />
			<Button x:Name="ImportButton" Grid.Column="2"
			        Command="{Binding ImportCommand}"
			        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportConfirm}"
			        AutomationProperties.Name="{x:Static lang:Strings.Import}">
				<primitives:AccessText Text="{x:Static lang:Strings.Import2}" />
			</Button>
		</Grid>

		<StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
			<Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
				<Label Content="{x:Static lang:Strings.AttachTags}" Target="{Binding #AttachTagsBox}" VerticalAlignment="Center" Margin="0,0,8,0" />
				<TextBox x:Name="AttachTagsBox"
				         Grid.Column="1"
				         Text="{Binding AttachTagsText}"
				         PlaceholderText="{x:Static lang:Strings.AttachTagsPlaceholder}"
				         AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportAttachTags}"
				         AutomationProperties.Name="{x:Static lang:Strings.AttachTags}" />
			</Grid>
			<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
				<CheckBox Content="{x:Static lang:Strings.DetectDuplicates2}" IsChecked="{Binding DuplicateDetect}"
				          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportDetectDuplicates}" />
				<CheckBox Grid.Column="1"
				          Content="{x:Static lang:Strings.CopyFilesToThePhotosFolder2}"
				          IsChecked="{Binding CopyFiles}"
				          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportCopyFiles}" />
				<CheckBox Grid.Row="1"
				          Content="{x:Static lang:Strings.IncludeSubfolders2}"
				          IsChecked="{Binding RecurseSubdirectories}"
				          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportIncludeSubfolders}" />
				<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
					<CheckBox Content="{x:Static lang:Strings.RemoveOriginalFilesAfterImport}"
					          IsChecked="{Binding RemoveOriginals}"
					          IsEnabled="{Binding RemoveOriginalsEnabled}"
					          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportRemoveOriginals}" />
					<Button Content="!"
					        IsEnabled="{Binding RemoveOriginalsEnabled}"
					        Command="{Binding WarnRemoveOriginalsCommand}"
					        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportRemoveOriginalsWarning}"
					        AutomationProperties.Name="{x:Static lang:Strings.WarningAboutRemovingOriginals}" />
				</StackPanel>
				<CheckBox Grid.Row="2"
				          Content="{x:Static lang:Strings.MergeRawAndJpegOnImport}"
				          IsChecked="{Binding MergeRawAndJpeg}"
				          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportMergeRawJpeg}" />
			</Grid>
		</StackPanel>

		<ProgressBar DockPanel.Dock="Bottom"
		             Margin="0,8,0,0"
		             Minimum="0"
		             Maximum="1"
		             Value="{Binding Progress}"
		             IsIndeterminate="{Binding IsScanning}"
		             IsVisible="{Binding IsProgressVisible}"
		             AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportProgress}"
		             AutomationProperties.Name="{x:Static lang:Strings.ImportProgress}" />
		<TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" Text="{Binding StatusText}"
		           AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportStatus}"
		           AutomationProperties.Name="{Binding StatusText}" />

		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
			<Label Target="{Binding #ImportSourceButton}" VerticalAlignment="Center">
				<primitives:AccessText Text="{x:Static lang:Strings.ImportFrom2}" />
			</Label>
			<Button x:Name="ImportSourceButton" Content="{Binding SourceLabel}" Command="{Binding ChooseFolderCommand}"
			        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportSource}"
			        AutomationProperties.Name="{x:Static lang:Strings.ImportFrom}" />
		</StackPanel>

		<Grid ColumnDefinitions="220,Auto,*">
			<ListBox Grid.Column="0" ItemsSource="{Binding Photos}" SelectedItem="{Binding SelectedPhoto}"
			         ContainerPrepared="OnThumbnailContainerPrepared"
			         ContainerClearing="OnThumbnailContainerClearing"
			         AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportPhotoList}"
			         AutomationProperties.Name="{x:Static lang:Strings.PhotosToImport}">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<VirtualizingStackPanel />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemTemplate>
					<DataTemplate DataType="vm:PhotoItemViewModel">
						<StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
							<Image Width="48" Height="48" Stretch="Uniform" Source="{Binding Thumbnail}" />
							<TextBlock Text="{Binding Caption}" VerticalAlignment="Center"
							           AutomationProperties.AutomationId="{Binding AutomationId}"
							           AutomationProperties.Name="{Binding Caption}" />
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<GridSplitter Grid.Column="1" Classes="hairline" ResizeDirection="Columns" />
			<Image Grid.Column="2"
			       Margin="8"
			       Stretch="Uniform"
			       Source="{Binding Preview}"
			       AutomationProperties.AutomationId="{x:Static auto:AutomationIds.ImportPreview}"
			       AutomationProperties.Name="{x:Static lang:Strings.ImportPreview}" />
		</Grid>
	</DockPanel>
</Window>
