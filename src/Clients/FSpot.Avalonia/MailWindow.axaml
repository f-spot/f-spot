<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="using:FSpot.Resources.Lang"
        xmlns:auto="using:FSpot.Avalonia"
        x:Class="FSpot.Avalonia.MailWindow"
        Title="{x:Static lang:Strings.CreateMail}"
        Width="640"
        Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        AutomationProperties.AutomationId="{x:Static auto:PrintAutomationIds.MailWindow}"
        AutomationProperties.Name="{x:Static lang:Strings.CreateMail}">
	<Window.Styles>
		<Style Selector="TextBlock.frame">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>
	</Window.Styles>
	<DockPanel Margin="16">
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
			<Button Classes="dialog" MinWidth="88" Content="{x:Static lang:Strings.DoNotSendAMail}" IsCancel="True" Click="OnCancel"
			        AutomationProperties.AutomationId="{x:Static auto:PrintAutomationIds.MailCancel}" />
			<Button Name="CreateButton" Classes="dialog accent" MinWidth="88" IsDefault="True" Click="OnCreate"
			        ToolTip.Tip="{x:Static lang:Strings.CreateAMailWithTheSelectedPhotosPossiblyResizedAttached}"
			        AutomationProperties.AutomationId="{x:Static auto:PrintAutomationIds.MailCreate}" />
		</StackPanel>
		<Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Classes="frame" Text="{x:Static lang:Strings.Photos}" />
				<ScrollViewer HorizontalScrollBarVisibility="Disabled">
					<ItemsControl Name="Tray" x:FieldModifier="internal"
					              AutomationProperties.AutomationId="{x:Static auto:PrintAutomationIds.MailTray}"
					              AutomationProperties.Name="{x:Static lang:Strings.Photos}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
			<StackPanel Grid.Column="1" Spacing="16" Width="280">
				<StackPanel>
					<TextBlock Classes="frame" Text="{x:Static lang:Strings.Size}" />
					<Grid Name="SizeChoices" x:FieldModifier="internal" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
					      ColumnSpacing="12" Margin="12,0,0,0"
					      AutomationProperties.AutomationId="{x:Static auto:PrintAutomationIds.MailSize}">
						<RadioButton Name="TinySize" x:FieldModifier="internal" GroupName="size" Content="{x:Static lang:Strings.Tiny}" IsCheckedChanged="OnSizeToggled" />
						<TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Static lang:Strings.S320Px}" />
						<RadioButton Name="SmallSize" x:FieldModifier="internal" Grid.Row="1" GroupName="size" Content="{x:Static lang:Strings.Small}" IsCheckedChanged="OnSizeToggled" />
						<TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{x:Static lang:Strings.S480Px}" />
						<RadioButton Name="MediumSize" x:FieldModifier="internal" Grid.Row="2" GroupName="size" Content="{x:Static lang:Strings.Medium}" IsCheckedChanged="OnSizeToggled" />
						<TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{x:Static lang:Strings.S640Px}" />
						<RadioButton Name="LargeSize" x:FieldModifier="internal" Grid.Row="3" GroupName="size" Content="{x:Static lang:Strings.Large}" IsCheckedChanged="OnSizeToggled" />
						<TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="{x:Static lang:Strings.S800Px}" />
						<RadioButton Name="XLargeSize" x:FieldModifier="internal" Grid.Row="4" GroupName="size" Content="{x:Static lang:Strings.ExtraLarge}" IsCheckedChanged="OnSizeToggled" />
						<TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="{x:Static lang:Strings.S1024Px}" />
						<RadioButton Name="OriginalSize" x:FieldModifier="internal" Grid.Row="5" GroupName="size" Content="{x:Static lang:Strings.Original}" IsCheckedChanged="OnSizeToggled" />
						<TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
						           Text="{x:Static lang:Strings.OriginalSizePossibleVeryLargeFileSize}" />
					</Grid>
				</StackPanel>
				<StackPanel>
					<TextBlock Name="SummaryHeading" Classes="frame" />
					<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4" Margin="12,0,0,0">
						<TextBlock Text="{x:Static lang:Strings.NumberOfPictures}" />
						<TextBlock Name="NumberOfPictures" x:FieldModifier="internal" Grid.Column="1"
						           AutomationProperties.AutomationId="{x:Static auto:PrintAutomationIds.MailCount}" />
						<TextBlock Grid.Row="1" Text="{x:Static lang:Strings.TotalOriginalSize}" />
						<TextBlock Name="TotalOriginalSize" x:FieldModifier="internal" Grid.Row="1" Grid.Column="1"
						           AutomationProperties.AutomationId="{x:Static auto:PrintAutomationIds.MailOriginalSize}" />
						<TextBlock Grid.Row="2" Text="{x:Static lang:Strings.EstimatedNewSize}" />
						<TextBlock Name="ApproxNewSize" x:FieldModifier="internal" Grid.Row="2" Grid.Column="1"
						           AutomationProperties.AutomationId="{x:Static auto:PrintAutomationIds.MailEstimatedSize}" />
					</Grid>
				</StackPanel>
			</StackPanel>
		</Grid>
	</DockPanel>
</Window>
