<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:FSpot.Avalonia"
        xmlns:lang="using:FSpot.Resources.Lang"
        x:Class="FSpot.Avalonia.PreferencesWindow"
        Title="{x:Static lang:Strings.Preferences}"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesWindow}"
        AutomationProperties.Name="{x:Static lang:Strings.Preferences}">
	<Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="220,*">
		<TextBlock Text="{x:Static lang:Strings.WhenImportingPhotosCopyThemTo}" VerticalAlignment="Center"
		           TextWrapping="Wrap" TextAlignment="Right" Margin="0,0,12,12" />
		<Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
			<TextBox Name="StoragePath" x:FieldModifier="internal"
			         AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesStoragePath}"
			         AutomationProperties.Name="{x:Static lang:Strings.WhenImportingPhotosCopyThemTo}" />
			<Button Grid.Column="1" Margin="8,0,0,0" Content="{x:Static lang:Strings.Browse}" Click="OnBrowse"
			        AutomationProperties.Name="{x:Static lang:Strings.SelectAFolder}" />
		</Grid>

		<TextBlock Grid.Row="1" Text="{x:Static lang:Strings.StoreTagsAndDescriptionsForPhotos}"
		           VerticalAlignment="Top" TextWrapping="Wrap" TextAlignment="Right" Margin="0,4,12,12" />
		<StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" Margin="0,0,0,12">
			<RadioButton Name="EmbedMetadata" x:FieldModifier="internal" GroupName="metadata"
			             AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesEmbedMetadata}"
			             AutomationProperties.Name="{x:Static lang:Strings.StoreTagsAndDescriptionsForPhotos}" />
			<RadioButton Name="SeparateMetadata" x:FieldModifier="internal" GroupName="metadata"
			             Content="{x:Static lang:Strings.SeparatelyFromTheImageFiles}"
			             AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesSeparateMetadata}" />
			<CheckBox Name="AlwaysSidecar" x:FieldModifier="internal" Margin="24,0,0,0"
			          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesSidecar}" />
		</StackPanel>

		<TextBlock Grid.Row="2" Text="{x:Static lang:Strings.ColorProfileForDisplay}" VerticalAlignment="Center"
		           TextWrapping="Wrap" TextAlignment="Right" Margin="0,0,12,12" />
		<ComboBox Name="DisplayProfile" x:FieldModifier="internal" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
		          Margin="0,0,0,12"
		          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesDisplayProfile}"
		          AutomationProperties.Name="{x:Static lang:Strings.ColorProfileForDisplay}" />

		<TextBlock Grid.Row="3" Text="{x:Static lang:Strings.ColorProfileForPrinting}" VerticalAlignment="Center"
		           TextWrapping="Wrap" TextAlignment="Right" Margin="0,0,12,12" />
		<ComboBox Name="PrintProfile" x:FieldModifier="internal" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
		          Margin="0,0,0,12"
		          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesPrintProfile}"
		          AutomationProperties.Name="{x:Static lang:Strings.ColorProfileForPrinting}" />

		<TextBlock Grid.Row="4" Text="{x:Static lang:Strings.FSpotAppearance}" VerticalAlignment="Center"
		           TextAlignment="Right" Margin="0,0,12,12" />
		<ComboBox Name="ColorScheme" x:FieldModifier="internal" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch"
		          Margin="0,0,0,12"
		          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesColorScheme}"
		          AutomationProperties.Name="{x:Static lang:Strings.FSpotAppearance}" />

		<CheckBox Name="ShowHoverPreview" x:FieldModifier="internal" Grid.Row="5" Grid.Column="1"
		          Content="{x:Static lang:Strings.ShowALargerPreviewWhenThePointerIsOverAPhoto}"
		          Margin="0,0,0,12"
		          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesHoverPreview}" />

		<CheckBox Name="ViewerInterpolation" x:FieldModifier="internal" Grid.Row="6" Grid.Column="1"
		          Content="{x:Static lang:Strings.InterpolateImageOnZoom}" Margin="0,0,0,12"
		          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesInterpolation}" />

		<TextBlock Grid.Row="7" Text="{x:Static lang:Strings.DisplayOfTransparentParts}" VerticalAlignment="Top"
		           TextWrapping="Wrap" TextAlignment="Right" Margin="0,4,12,12" />
		<StackPanel Grid.Row="7" Grid.Column="1" Spacing="6" Margin="0,0,0,12">
			<RadioButton Name="TransparencyBackground" x:FieldModifier="internal" GroupName="transparency"
			             AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesTransparencyBackground}" />
			<RadioButton Name="TransparencyCheckPattern" x:FieldModifier="internal" GroupName="transparency"
			             AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesTransparencyCheckPattern}" />
			<StackPanel Orientation="Horizontal" Spacing="8">
				<RadioButton Name="TransparencyCustomColor" x:FieldModifier="internal" GroupName="transparency"
				             AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesTransparencyCustomColor}" />
				<Border Name="TransparencyColorSwatch" x:FieldModifier="internal" Width="20" Height="20"
				        BorderBrush="Gray" BorderThickness="1" VerticalAlignment="Center" />
				<TextBox Name="TransparencyColorHex" x:FieldModifier="internal" Width="90"
				         AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesTransparencyColorHex}"
				         AutomationProperties.Name="{x:Static lang:Strings.TheColorToUseForTransparentParts}" />
			</StackPanel>
			<TextBlock Text="{x:Static lang:Strings.YouCanChooseHowToDisplayTransparentPartsInImagesThisOptionHasNoEffectOnPhotosButSettingThisValueToCHECKPATTERNOrCUSTOMCOLORCouldBeUsefulWhenViewingIconsOrOtherArtworkWithTransparentParts}"
			           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
		</StackPanel>

		<CheckBox Name="MailEnabled" x:FieldModifier="internal" Grid.Row="8" Grid.Column="1"
		          Content="{x:Static lang:Strings.EnableSendingPhotosByMail}" Margin="0,0,0,12"
		          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesMailEnabled}" />

		<CheckBox Name="SendCrashReports" x:FieldModifier="internal" Grid.Row="9" Grid.Column="1"
		          Content="{x:Static lang:Strings.SendCrashReportsToSentry}" Margin="0,0,0,12"
		          AutomationProperties.AutomationId="{x:Static auto:AutomationIds.PreferencesSendCrashReports}" />

		<Button Grid.Row="10" Grid.Column="1" HorizontalAlignment="Right" MinWidth="88" Classes="dialog"
		        Content="{x:Static lang:Strings.Close}" Click="OnClose" />
	</Grid>
</Window>
