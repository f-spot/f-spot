<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="using:FSpot.Resources.Lang"
        xmlns:auto="using:FSpot.Avalonia"
        xmlns:vm="using:FSpot.Avalonia.ViewModels"
        x:Class="FSpot.Avalonia.AdjustTimeWindow"
        Title="{x:Static lang:Strings.AdjustTime}"
        Width="640"
        Height="480"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeWindow}"
        AutomationProperties.Name="{x:Static lang:Strings.AdjustTime}">
	<DockPanel Margin="16">
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
			<Button Classes="dialog" MinWidth="88" Content="{x:Static lang:Strings.Cancel}" IsCancel="True" Click="OnCancel"
			        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.DialogCancel}" />
			<Button Name="OkButton" x:FieldModifier="internal" Classes="dialog accent" MinWidth="88"
			        Content="{x:Static lang:Strings.Ok}" IsDefault="True" Click="OnOk"
			        AutomationProperties.AutomationId="{x:Static auto:AutomationIds.DialogOk}" />
		</StackPanel>
		<Grid ColumnDefinitions="*,220" ColumnSpacing="16">
			<StackPanel Grid.Column="0" Spacing="16">
				<StackPanel Spacing="8">
					<TextBlock Text="{x:Static auto:AdjustTimeLabels.ReferencePhoto}" FontWeight="Bold" />
					<TextBlock Name="PhotoName" x:FieldModifier="internal" FontWeight="SemiBold" TextWrapping="Wrap"
					           AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeName}" />
					<Border Width="320" Height="200" HorizontalAlignment="Left" ClipToBounds="True"
					        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
						<Image Name="PreviewImage" x:FieldModifier="internal" Stretch="Uniform"
						       AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimePreview}"
						       AutomationProperties.Name="{x:Static lang:Strings.AdjustTime}" />
					</Border>
					<StackPanel Name="CounterRow" x:FieldModifier="internal" Orientation="Horizontal" Spacing="8">
						<TextBlock Name="CountLabel" x:FieldModifier="internal" VerticalAlignment="Center" MinWidth="60" />
						<NumericUpDown Name="PhotoSpin" x:FieldModifier="internal" Width="110" Minimum="1" Increment="1"
						               FormatString="0" ParsingNumberStyle="Integer"
						               ValueChanged="OnSpinChanged"
						               AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeSpin}"
						               AutomationProperties.Name="{x:Static lang:Strings.PhotoOutOfPhotos}" />
					</StackPanel>
					<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static lang:Strings.AdjustedDate}" VerticalAlignment="Center" />
						<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
							<DatePicker Name="AdjustedDatePart" x:FieldModifier="internal"
							            SelectedDateChanged="OnAdjustedDateChanged"
							            AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeAdjustedDate}"
							            AutomationProperties.Name="{x:Static lang:Strings.AdjustedDate}" />
							<TimePicker Name="AdjustedTimePart" x:FieldModifier="internal"
							            SelectedTimeChanged="OnAdjustedTimeChanged"
							            AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeAdjustedTime}"
							            AutomationProperties.Name="{x:Static lang:Strings.AdjustedDate}" />
						</StackPanel>
						<TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static lang:Strings.CurrentDate}" VerticalAlignment="Center" />
						<TextBlock Grid.Row="1" Grid.Column="1" Name="OldTime" x:FieldModifier="internal" VerticalAlignment="Center" />
					</Grid>
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Text="{x:Static lang:Strings.Difference}" VerticalAlignment="Center" />
						<TextBox Name="DifferenceBox" x:FieldModifier="internal" Width="140" TextChanged="OnDifferenceChanged"
						         AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeDifference}"
						         AutomationProperties.Name="{x:Static lang:Strings.Difference}" />
					</StackPanel>
				</StackPanel>

				<StackPanel Name="ActionSection" x:FieldModifier="internal" Spacing="8">
					<TextBlock Text="{x:Static auto:AdjustTimeLabels.Action}" FontWeight="Bold" />
					<RadioButton Name="ShiftAll" x:FieldModifier="internal" GroupName="AdjustTimeMode"
					             IsCheckedChanged="OnModeChanged"
					             AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeShift}" />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<RadioButton Name="SpaceAll" x:FieldModifier="internal" GroupName="AdjustTimeMode"
						             Content="{x:Static lang:Strings.SpaceAllPhotosBy}"
						             IsCheckedChanged="OnModeChanged"
						             AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeSpace}" />
						<TextBox Name="SpacingBox" x:FieldModifier="internal" Width="60" Text="5" TextChanged="OnSpacingChanged"
						         AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeSpacing}"
						         AutomationProperties.Name="{x:Static lang:Strings.SpaceAllPhotosBy}" />
						<TextBlock Name="StartingAtLabel" x:FieldModifier="internal" VerticalAlignment="Center" />
					</StackPanel>
				</StackPanel>
			</StackPanel>

			<StackPanel Grid.Column="1" Name="TraySection" x:FieldModifier="internal" Spacing="8">
				<TextBlock Text="{x:Static auto:AdjustTimeLabels.Photos}" FontWeight="Bold" />
				<ListBox Name="PhotoList" x:FieldModifier="internal"
				         AutomationProperties.AutomationId="{x:Static auto:AutomationIds.AdjustTimeTray}"
				         AutomationProperties.Name="{x:Static auto:AdjustTimeLabels.Photos}">
					<ListBox.ItemTemplate>
						<DataTemplate DataType="vm:AdjustTimePhotoItem">
							<StackPanel Orientation="Horizontal" Spacing="6" Margin="2">
								<Image Width="32" Height="32" Stretch="Uniform" Source="{Binding Thumbnail}" />
								<StackPanel>
									<TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
									<TextBlock Text="{Binding TimeCaption}" FontSize="11" Opacity="0.7" />
								</StackPanel>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</Grid>
	</DockPanel>
</Window>
