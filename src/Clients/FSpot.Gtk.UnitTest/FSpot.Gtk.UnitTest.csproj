<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>$(RepoRoot)artifacts/fspot-gtk-test/</OutputPath>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile CompletionLogic here so the testhost does not load f-spot.exe. -->
    <Compile Include="..\FSpot.Gtk\FSpot.Widgets\CompletionLogic.cs" Link="FSpot.Widgets\CompletionLogic.cs" />
    <!-- AndTerm lives in FSpot.Gtk and needs a Gtk runtime. -->
    <Compile Remove="FSpot\AndTermTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dllmaps under test. Read as data, not compiled. -->
    <Content Include="..\FSpot.Gtk\f-spot.exe.config.in" Link="f-spot.exe.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\lib\Hyena\Hyena.csproj" />
    <ProjectReference Include="..\..\Core\FSpot\FSpot.csproj" />
  </ItemGroup>

</Project>
