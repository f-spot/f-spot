<configuration>
  <dllmap dll="libXcomposite.dll" target="libXcomposite.so.1"/>
  <dllmap dll="X11" target="libX11.so.6"/>

	<dllmap dll="libgdk_pixbuf-2.0-0.dll" target="libgdk_pixbuf-2.0.so.0"/>

	<dllmap os="!windows,osx" dll="libglib-2.0-0.dll" target="libglib-2.0.so.0"/>
  <dllmap os="osx" dll="libglib-2.0-0.dll" target="libglib-2.0.0.dylib"/>

  <dllmap dll="libgobject-2.0-0.dll" target="libgobject-2.0.so.0" os="!osx,windows" />
  <dllmap dll="libgobject-2.0-0.dll" target="libgobject-2.0.dylib" os="osx" />

  <dllmap os="!windows,osx" dll="libatk-1.0-0.dll" target="libatk-1.0.so.0"/>
  <dllmap os="osx" dll="libatk-1.0-0.dll" target="libatk-1.0.0.dylib"/>

  <dllmap dll="libgtk-win32-2.0-0.dll" target="libgtk-x11-2.0.so.0" os="!osx,windows"/>
  <dllmap dll="libgtk-win32-2.0-0.dll" target="libgtk-quartz-2.0.dylib" os="osx"/>

  <dllmap dll="libgdk-win32-2.0-0.dll" target="libgdk-x11-2.0.so.0" os="!osx,windows"/>
  <dllmap dll="libgdk-win32-2.0-0.dll" target="libgdk-quartz-2.0.dylib" os="osx"/>

  <!-- GdkUtils and CompositeUtils import libgdk under its unsuffixed name, which is
       the one Mono actually has to resolve; the win32 spelling above is gtk-sharp's. -->
  <dllmap dll="libgdk-2.0-0.dll" target="libgdk-x11-2.0.so.0" os="!osx,windows"/>
  <dllmap dll="libgdk-2.0-0.dll" target="libgdk-quartz-2.0.dylib" os="osx"/>

  <dllmap dll="libpangocairo-1.0-0.dll" target="libpangocairo-1.0.so.0" os="!windows,osx"/>
  <dllmap dll="libpangocairo-1.0-0.dll" target="libpangocairo-1.0.dylib" os="osx"/>
  <dllmap dll="libpango-1.0-0.dll" target="libpango-1.0.so.0" os="!windows,osx"/>
  <dllmap dll="libpango-1.0-0.dll" target="libpango-1.0.dylib" os="osx"/>
  <dllmap dll="libcairo-2.dll" target="libcairo.so.2" os="!windows,osx"/>
  <dllmap dll="libcairo-2.dll" target="libcairo.2.dylib" os="osx"/>
</configuration>
