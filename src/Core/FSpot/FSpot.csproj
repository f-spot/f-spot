<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(FSpotModernTargetFramework)</TargetFramework>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ReleaseVersion>0.9.0</ReleaseVersion>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <OutputPath>$(RepoRoot)artifacts/fspot/$(TargetFramework)/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSpot.Resources\FSpot.Resources.csproj" />
    <ProjectReference Include="..\FSpot.Strings\FSpot.Strings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Metapackage already includes SQLitePCLRaw.bundle_e_sqlite3. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="lcmsNET" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Exceptions" />
    <PackageReference Include="SerilogTimings" />
    <PackageReference Include="Sentry.Serilog" />
    <PackageReference Include="TagLibSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Gallery\f-spot-simple.css">
      <LogicalName>f-spot-simple.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Gallery\f-spot-simple-white.css">
      <LogicalName>f-spot-simple-white.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Gallery\f-spot.js">
      <LogicalName>f-spot.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="lcmsNET.dll.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Mono on macOS is x86_64; Homebrew liblcms2 is arm64. The dllmap target is the
         versioned dylib name, which only resolves if that file sits next to lcmsNET.dll. -->
    <None Include="$(RepoRoot)lib/native/osx-x64/liblcms2.2.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
      <Link>liblcms2.2.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
