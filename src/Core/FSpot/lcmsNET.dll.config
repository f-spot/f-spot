<!--
  Mono dllmap for the lcmsNET package. lcmsNET imports the bare name "lcms2", which
  only resolves where an unversioned liblcms2 symlink exists (a -dev package). Mono
  reads this file because it sits next to lcmsNET.dll: a mapping in FSpot.dll.config
  would not be consulted for another assembly's imports.
-->
<configuration>
  <dllmap dll="lcms2" target="liblcms2.so.2" os="!osx,windows"/>
  <dllmap dll="lcms2" target="liblcms2.2.dylib" os="osx"/>
</configuration>
