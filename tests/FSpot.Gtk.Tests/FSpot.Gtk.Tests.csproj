<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(FSpotModernTargetFramework)</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>$(RepoRoot)artifacts/fspot-gtk-test/</OutputPath>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same for the help text: it is plain string formatting with no Gtk in it. -->
    <Compile Include="..\..\src\Clients\FSpot.Gtk\FSpot\CommandLineHelp.cs" Link="FSpot\CommandLineHelp.cs" />
    <Compile Include="..\..\src\Clients\FSpot.Gtk\FSpot.Loaders\ThumbnailHandoff.cs" Link="FSpot\ThumbnailHandoff.cs" />
    <Compile Include="..\..\src\Clients\FSpot.Gtk\FSpot.Extensions\AddinAttributeNames.cs" Link="FSpot\AddinAttributeNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dllmaps under test. Read as data, not compiled. -->
    <Content Include="..\..\src\Clients\FSpot.Gtk\f-spot.exe.config" Link="f-spot.exe.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\FSpot\FSpot.csproj" />
  </ItemGroup>

</Project>
