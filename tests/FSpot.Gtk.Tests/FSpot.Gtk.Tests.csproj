<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>$(RepoRoot)artifacts/fspot-gtk-test/</OutputPath>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile CompletionLogic here so the testhost does not load f-spot.exe. -->
    <Compile Include="..\..\src\Clients\FSpot.Gtk\FSpot.Widgets\CompletionLogic.cs" Link="FSpot.Widgets\CompletionLogic.cs" />
    <!-- Same for the help text: it is plain string formatting with no Gtk in it. -->
    <Compile Include="..\..\src\Clients\FSpot.Gtk\FSpot\CommandLineHelp.cs" Link="FSpot\CommandLineHelp.cs" />
    <!-- AndTerm lives in FSpot.Gtk and needs a Gtk runtime. -->
    <Compile Remove="FSpot\AndTermTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dllmaps under test. Read as data, not compiled. -->
    <Content Include="..\..\src\Clients\FSpot.Gtk\f-spot.exe.config" Link="f-spot.exe.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\lib\Hyena\Hyena.csproj" />
    <ProjectReference Include="..\..\src\Core\FSpot\FSpot.csproj" />
  </ItemGroup>

</Project>
