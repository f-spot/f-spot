<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(FSpotModernTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>$(RepoRoot)artifacts/rasterize-icons/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RasterizeIcons>false</RasterizeIcons>
  </PropertyGroup>

  <!-- A client build invokes this project with another intermediate directory.
       The default obj folder is then no longer excluded, and its generated
       sources would be compiled again. -->
  <ItemGroup Condition="'$(BaseIntermediateOutputPath)' != '' and !$(BaseIntermediateOutputPath.StartsWith('obj'))">
    <Compile Remove="obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

</Project>
